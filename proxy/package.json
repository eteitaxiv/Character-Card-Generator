{
  "name": "character-generator-proxy",
  "version": "1.0.0",
  "description": "Proxy server for character generator to bypass browser API restrictions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "proxy",
    "api",
    "cors",
    "character-generator"
  ],
  "author": "Character Generator Proxy",
  "license": "MIT",
  "overrides": {
    "proxy-addr": "2.0.8",
    "ip-address": "10.3.1",
    "forwarded": "0.2.0"
  }
